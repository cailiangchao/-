    <!-- 应用A计权 -->
    <multiply id="weightedSpectrum" a="spectrum" b="Aweight"/>

    <!-- 计算加权RMS -->
    <rms id="rmsA" input="weightedSpectrum"/>

    <!-- 转换为dB -->
    <formula id="dBA" input="rmsA" output="dBA">
      20*log10(input0) + offset
    </formula>

    <!-- 主导频率检测（谱峰法） -->
    <maxindex id="peakIndex" input="spectrum"/>
    <formula id="freq" input="peakIndex" output="freq">
      input0 * (22050/2048)
    </formula>
  </analysis>

  <!-- 参数：校准偏置 -->
  <parameters>
    <parameter id="offset" default="0" min="-40" max="40" step="0.5" unit="dB"/>
  </parameters>

  <!-- 输出视图 -->
  <view>
    <number id="dBA" label="声压级 (dB(A))" digits="1"/>
    <number id="freq" label="主导频率 (Hz)" digits="1"/>
    <graph label="声压级历史" xmin="0" xmax="30" ymin="0" ymax="120" xlabel="时间 (s)" ylabel="dB(A)">
      <input source="dBA"/>
    </graph>
    <graph label="频率历史" xmin="0" xmax="30" ymin="0" ymax="11025" xlabel="时间 (s)" ylabel="Hz">
      <input source="freq"/>
    </graph>
    <slider id="offset" label="校准偏置 (dB)" />
  </view>
</phyphox>
